      organization="Aviva"
      website="https://venerable-marshmallow-1bc045.netlify.app"
    />
    <min-api-version>1.10</min-api-version>
    <source-location>
      <url>https://venerable-marshmallow-1bc045.netlify.app</url>
    </source-location>
    <icon>iVBORw0KGgoAAAANSUhEUgAAAEYAAABGCAYAAABxLuKEAAAASUlEQVR42u3BMQEAAADCoPVP7WsIoAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAeAMBxAABHgAAAABJRU5ErkJggg==</icon>
  </dashboard-extension>
  <resources>
